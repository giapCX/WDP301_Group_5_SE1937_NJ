{
  "name": "xedi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:operator",
    "dev:operator": "concurrently --kill-others --names BE,FE \"npm run dev:operator --prefix BE\" \"npm run dev --prefix FE -- --host 127.0.0.1\"",
    "dev:be": "npm run dev --prefix BE",
    "dev:fe": "npm run dev --prefix FE -- --host 127.0.0.1",
    "db:local": "npm run db:local --prefix BE",
    "db:setup": "npm run db:setup --prefix BE",
    "db:seed": "npm run db:seed --prefix BE",
    "db:seed:sample": "npm run db:seed:sample --prefix BE",
    "install:all": "npm install && npm ci --prefix BE && npm ci --prefix FE",
    "build": "npm run build --prefix FE"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
