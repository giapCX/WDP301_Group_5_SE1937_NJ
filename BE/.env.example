PORT=9999
MONGO_URI=mongodb://127.0.0.1:27017/tourist_car_rental_demo?replicaSet=rentalLocal
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development
OTP_SECRET=replace-with-a-stable-secret-of-at-least-32-bytes
LOGIN_ATTEMPT_WINDOW_MS=900000
LOGIN_ATTEMPT_MAX=15
SESSION_DURATION_MS=43200000
REMEMBER_SESSION_DURATION_MS=2592000000
OTP_LIFETIME_MS=600000
OTP_RESEND_DELAY_MS=60000
OTP_MAX_ATTEMPTS=5
SMTP_USER=
SMTP_PASS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# simulation (default in development) or stripe; simulation is disabled in production
PAYMENT_MODE=simulation
