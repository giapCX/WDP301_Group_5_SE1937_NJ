PORT=5000
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=xedi
FRONTEND_ORIGIN=http://localhost:3000

# Development only. Leave blank to keep garage APIs disabled.
# Generate a random token of at least 32 characters; never expose it in FE source.
GARAGE_API_TOKEN=
# An active users._id with the vehicle.intake permission.
GARAGE_STAFF_ID=
# Confirming an intake requires a replica set (or MongoDB Atlas), e.g.:
# MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
