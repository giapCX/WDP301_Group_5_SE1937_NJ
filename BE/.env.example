PORT=5000
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0
MONGODB_DB_NAME=xedi
# For the shared Atlas database, replace MONGODB_URI above in BE/.env only.
# MONGODB_URI=mongodb+srv://<database_user>:<encoded_password>@<atlas_hostname>/?authSource=admin
# Obtain the current hostname and credentials from the team; see README.md.
# Run npm run db:local before connecting to the default local replica set.
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET=xedi-super-secret-jwt-key-2026-development
DEFAULT_USER_PASSWORD=123456
# Set all three to store private uploads for every actor in Cloudinary.
# This covers Garage photos and Owner vehicle documents, vehicle photos and incident evidence.
# Keep actual credentials in BE/.env; do not commit them.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional local Garage photo storage, used only when Cloudinary is not configured.
# GARAGE_UPLOAD_DIRECTORY=

# Garage APIs use the JWT returned by POST /api/auth/login.
# Confirming an intake or submitting an inspection requires a replica set / Atlas, e.g.:
# MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0

# Development only. No real OTP, eKYC or money movement. Disabled in production.
RENTER_DEMO_SERVICES=false

# Email OTP registration and password reset (real SMTP only, never demo OTP).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
