{
  "name": "xedi-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "XeDi Node.js API and MongoDB database initialization",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:local": "node scripts/start-local-db.js",
    "db:setup": "node scripts/setup-db.js",
    "db:seed": "node scripts/seed-db.js",
    "db:migrate:operator-staff": "node scripts/migrate-operator-staff.js up",
    "db:rollback:operator-staff": "node scripts/migrate-operator-staff.js down",
    "db:demo-cleanup": "node scripts/clean-garage-demo.js",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.12.0"
  }
}
